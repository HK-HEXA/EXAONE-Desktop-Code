# ── 의존성 · 빌드 산출물 ─────────────────────────────────
node_modules/
dist/
build/
out/
release/

# ── 로그 ───────────────────────────────────────────────
# 프롬프트·파일 내용·원시 응답이 들어가는 민감 파일.
# (개발 실행은 저장소 logs/, 패키징 앱은 사용자 데이터 폴더 logs/ — 공유 금지)
logs/
*.log

# ── 프로젝트 로컬 에이전트 설정 ────────────────────────
# .exaone/settings.local.json 의 permissions.allow("다시 묻지 않기" 규칙) 등
# 기기·사용자 의존 설정. 팀 공유가 필요하면 `git add -f`.
.exaone/

# ── 시크릿 (방어적) ────────────────────────────────────
# 이 프로젝트는 키를 저장소에 두지 않는다(앱 등록 또는 ~/.exaone/key.txt 만).
# 예전 읽기 경로였던 폴더 key.txt 등의 실수 유입을 막아 둔다.
key.txt
.env

# ── 사용자 로고 오버라이드 ─────────────────────────────
# assets/logo.(svg|png|jpg|webp) 는 로컬 오버라이드용. 같이 배포하려면
# `git add -f assets/logo.*`.
assets/logo.*

# ── OS · 에디터 찌꺼기 ────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
*.swp
*~

# ── 배포 빌드 때 함께 넣는 Node 실행 파일 ─────────────────
# release 워크플로가 runtime/node/node.exe 를 준비한다 (저장소에는 넣지 않는다).
runtime/
